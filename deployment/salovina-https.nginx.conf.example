# Replace example.com and certificate paths, then merge these directives with
# salovina.nginx.conf after issuing a certificate (for example with Certbot).
server {
    listen 80;
    server_name example.com www.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com www.example.com;

    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Copy the root, /api, /static, /media, /assets, /brand and /images
    # locations from salovina.nginx.conf into this server block.
}
