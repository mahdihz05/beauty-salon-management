[Unit]
Description=Beauty Salon Management Django Gunicorn
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/beauty-salon-management/backend
EnvironmentFile=/opt/beauty-salon-management/backend/.env
ExecStart=/opt/beauty-salon-management/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8021 --workers 2 --worker-class gthread --threads 4 --timeout 120 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100 --access-logfile - --error-logfile -
Restart=always
RestartSec=5
UMask=0027
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
